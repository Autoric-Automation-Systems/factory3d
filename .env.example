# Auth.js — obrigatório em produção
# Gere com: openssl rand -base64 32
# Trocar este valor invalida todas as sessões (os cookies antigos deixam de ser
# decifráveis e aparece "no matching decryption secret" no log).
AUTH_SECRET=troque-por-uma-string-aleatoria-longa
AUTH_TRUST_HOST=true

# Login com Google
# https://console.cloud.google.com/apis/credentials
# Redirect URI: https://SEU_DOMINIO/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Banco de dados
# Produção: string de conexão do Neon (a integração da Vercel cria DATABASE_URL).
# Local: sem esta variável o app usa um arquivo JSON em DATA_DIR.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATA_DIR=.data
