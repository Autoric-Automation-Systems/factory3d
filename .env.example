# Auth.js — obrigatório em produção
# Gere com: openssl rand -base64 32
AUTH_SECRET=troque-por-uma-string-aleatoria-longa
AUTH_TRUST_HOST=true

# Login com Google
# https://console.cloud.google.com/apis/credentials
# Redirect URI: https://SEU_DOMINIO/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Armazenamento do progresso
# Local: arquivo JSON em DATA_DIR (padrão .data/db.json)
DATA_DIR=.data
#
# Produção (Vercel): adicione um Redis pelo Marketplace (Upstash / Vercel KV).
# A integração cria automaticamente KV_REST_API_URL e KV_REST_API_TOKEN.
# Também aceita os nomes UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
