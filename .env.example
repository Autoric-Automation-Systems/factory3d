# Auth.js
AUTH_SECRET=troque-por-uma-string-aleatoria-longa
AUTH_URL=http://localhost:12000
AUTH_TRUST_HOST=true

# Login com Google (crie em https://console.cloud.google.com/apis/credentials)
# Sem estas variáveis o app roda em modo demonstração (login "Entrar para testar").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Persistência do MVP: arquivo JSON (padrão) ou Postgres
DATA_DIR=.data
# DATABASE_URL=postgres://user:pass@host:5432/factory3d
